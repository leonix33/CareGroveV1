# CareGrove local defaults. Copy to services/api/.env and apps/web/.env.local as needed.

# API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./caregrove.db
JWT_SECRET=change-me-before-any-shared-deployment
FRONTEND_URL=http://localhost:3000
# Leave empty until Patricia sets the monthly price. Paid enrollment stays closed.
MONTHLY_PRICE_USD=
# Development only. Records a verified payment so Suggested matches can be exercised.
ALLOW_DEMO_PAYMENTS=true

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
